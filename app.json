{
  "expo": {
    "name": "Arcanist",
    "slug": "arcanist",
    "scheme": "arcanist",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/images/arcanist_icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.asoze.arcanist",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/arcanist_icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router"],
    "extra": {
      "eas": {
        "projectId": "35615dbc-270e-4a60-a28c-e1012f51b533"
      }
    }
  }
}
